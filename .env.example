#tf-apply config template (placeholders only) — copy to deploy/.runner.env for the runtime; mirror the TF_*_DIR / TF_WORKSPACE_ROOT / UID / GID keys into ./.env for docker compose ${...} interpolation.
TF_RUNNER_PORT=1937
TF_ALLOWED_ROOTS=/abs/path/to/terraform/root:/abs/path/to/second/root
TF_MAX_CONCURRENT_RUNS=4
RUNS_DIR=/abs/path/to/tf-apply-runner/runs
UNROUTED_DIR=/abs/path/to/pipeline/ready/_unrouted
AWS_PROFILE=tf-runner
AWS_SHARED_CREDENTIALS_FILE=${HOME}/.aws/credentials
TF_CLI_CONFIG_FILE=/etc/tf-apply/empty.tfrc
TF_LOG=
X_RUNNER_TOKEN=replace-with-openssl-rand-hex-32
TF_RUNNER_UID=1000
TF_RUNNER_GID=1000
TF_WORKSPACE_ROOT=/abs/path/to/workspace
TF_UNROUTED_DIR=/abs/path/to/pipeline/ready/_unrouted
TF_AWS_DIR=${HOME}/.aws
